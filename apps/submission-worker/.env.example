KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_INPUT_TOPIC=claims.flagged
KAFKA_CONSUMER_GROUP=submission-worker

# apps/blockchain_gateway gateway. Use the ai_submitter key (SUBMITTER_API_KEY in
# the repo-root .env written by blockchain/scripts/gen-secrets.sh).
BLOCKCHAIN_API_BASE=http://localhost:8000
BLOCKCHAIN_API_KEY=
# HMAC key that claims.flagged messages must carry
PIPELINE_FLAGGED_KEY=
DEFAULT_LANGUAGE=eng

OUTPUT_PATH=./data/failed_claims.jsonl
PROCESSED_DB=./data/processed.db

LOG_LEVEL=INFO
