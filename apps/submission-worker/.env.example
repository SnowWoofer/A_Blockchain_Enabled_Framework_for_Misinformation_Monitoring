KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_INPUT_TOPIC=claims.flagged
KAFKA_CONSUMER_GROUP=submission-worker

# apps/blockchain_gateway gateway. Use an org fact_checker key from blockchain/runtime/<name>/credentials.json.
BLOCKCHAIN_API_BASE=http://localhost:8000
BLOCKCHAIN_API_KEY=key-org1
DEFAULT_LANGUAGE=eng

OUTPUT_PATH=./data/failed_claims.jsonl

LOG_LEVEL=INFO
