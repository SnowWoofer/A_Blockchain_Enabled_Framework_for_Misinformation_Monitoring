BLOCKCHAIN_API_BASE=http://localhost:8000

# One key per org (from blockchain/scripts/bootstrap-keys.sh) — the same
# keys blockchain_gateway itself accepts. An org authenticates to this
# service by presenting its own key as X-API-Key. Passed as a JSON object
# since pydantic-settings reads dict-typed env vars as JSON.
ORG_API_KEYS={"org1":"key-org1","org2":"key-org2","org3":"key-org3"}

LOG_LEVEL=INFO
