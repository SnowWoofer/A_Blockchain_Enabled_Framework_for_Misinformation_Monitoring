# --- Laptop test (Mac / no GPU) ---
TORCH_DEVICE=cpu
MODEL_QUANTIZATION=int8
MAX_BATCH_SIZE=4
MAX_QUEUE_DELAY_MS=50

# --- 5090 server test (uncomment / override) ---
# TORCH_DEVICE=cuda
# MODEL_QUANTIZATION=fp16
# MAX_BATCH_SIZE=64
# MAX_QUEUE_DELAY_MS=5

MODEL_PATH=./model
MODEL_MAX_LENGTH=256
FLAG_THRESHOLD=0.5

KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_INPUT_TOPIC=claims.raw
KAFKA_OUTPUT_TOPIC=claims.flagged
KAFKA_CONSUMER_GROUP=flagging-engine

LOG_LEVEL=INFO
